    { "rule": "学号_姓名_课程名称", "file": "2024001_张三_数据结构.docx", "ok": true, "problems": [] },
    { "rule": "学号_姓名_课程名称", "file": "2024001_张三.pdf", "ok": false, "problems": ["segment-count"] },
    { "rule": "学号_姓名_课程名称", "file": "2024001_张三_数据结构_额外.pdf", "ok": false, "problems": ["segment-count"] },
    { "rule": "学号_姓名_课程名称", "file": "张三_2024001_数据结构.pdf", "ok": false, "problems": ["field:name", "field:studentId"] },
    { "rule": "学号_姓名_课程名称", "file": "2024001-张三-数据结构.pdf", "ok": false, "problems": ["separator"] },
    { "rule": "学号_姓名_课程名称", "file": "123_张三_数据结构.pdf", "ok": false, "problems": ["field:studentId"] },
    { "rule": "学号_姓名_课程名称", "file": "2024001_张_数据结构.pdf", "ok": false, "problems": ["field:name"] },
    { "rule": "学号_姓名_课程名称", "file": "2024001_张三_12345.pdf", "ok": false, "problems": ["field:course"] },
    { "rule": "学号_姓名_课程名称", "file": "随便起个名.pdf", "ok": false, "problems": ["segment-count", "separator"] },
    { "rule": "学号_姓名_课程名称", "file": "_123456_张三_随便.pdf", "ok": false, "problems": ["empty-segment"] },
    { "rule": "学号_姓名_课程名称", "file": "2024001__张三_数据结构.pdf", "ok": false, "problems": ["empty-segment"] },
    { "rule": "学号_姓名_课程名称", "file": "2024001_张三_数据结构_.pdf", "ok": false, "problems": ["empty-segment"] },

    { "rule": "学号、姓名、课程名称", "file": "2024001_张三_数据结构.pdf", "ok": true, "problems": [] },
    { "rule": "学号、姓名、课程名称", "file": "随便起个名.pdf", "ok": false, "problems": ["segment-count"] },

    { "rule": "学号_姓名_课程名称.pdf", "file": "2024001_张三_数据结构.pdf", "ok": true, "problems": [] },
    { "rule": "学号_姓名_课程名称.pdf", "file": "2024001_张三_数据结构.docx", "ok": false, "problems": ["extension"] },

    { "rule": "学号-姓名-课程名称", "file": "2024001-张三-数据结构.pdf", "ok": true, "problems": [] },
    { "rule": "学号-姓名-课程名称", "file": "2024001_张三_数据结构.pdf", "ok": false, "problems": ["separator"] },

    { "rule": "班级_姓名_实验名称", "file": "计科2101_张三_冒泡排序.pdf", "ok": true, "problems": [] },
    { "rule": "班级_姓名_实验名称", "file": "计科2101_张三.pdf", "ok": false, "problems": ["segment-count"] },

    { "rule": "学号_姓名", "file": "2024001_张三.pdf", "ok": true, "problems": [] },
    { "rule": "学号_姓名", "file": "2024001_张三_数据结构.pdf", "ok": false, "problems": ["segment-count"] },

    { "rule": "学号", "file": "2024001.pdf", "ok": true, "problems": [] },
    { "rule": "学号", "file": "2024001_张三.pdf", "ok": false, "problems": ["segment-count"] },

    { "rule": "只要一张图片", "file": "随便起个名.pdf", "recognised": false }

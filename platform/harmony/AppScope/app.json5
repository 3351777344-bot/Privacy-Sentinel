{
  "app": {
    "bundleName": "com.guardianhub.campus",
    "vendor": "GuardianHub",
    // Must match the version recorded in the release provision profile
    // (D:\GuardianHubRelease.p7b), otherwise the signature check fails on
    // install and the package is rejected by AppGallery.
    "versionCode": 2,
    "versionName": "2.0.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name"
  }
}

